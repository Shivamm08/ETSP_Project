# Copy this file to .env (in this folder) and fill in your own keys.
# .env is listed in .gitignore, so it is never committed.

# Google Cloud Translation API, for translation/run_google.py.
# console.cloud.google.com: create a project, enable "Cloud Translation API",
# then APIs & Services > Credentials > Create credentials > API key.
GOOGLE_TRANSLATE_API_KEY=

# Groq, for translation/run_llm.py (gpt-oss-120b, gpt-oss-20b, qwen3.8-27b).
# console.groq.com/keys
GROQ_API_KEY=

# Sarvam, for translation/run_llm.py (sarvam-105b).
# dashboard.sarvam.ai
SARVAM_API_KEY=

# Hugging Face, for translation/run_indictrans2.py (the model is gated). Use your own account:
# accept the terms at huggingface.co/ai4bharat/indictrans2-en-indic-dist-200M, then create a
# read token at huggingface.co/settings/tokens. A token here overrides any `hf auth login`.
HF_TOKEN=
